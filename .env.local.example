# Mailchimp Configuration
# This handles both newsletter subscriptions and contact form inquiries
# Get these values from your Mailchimp account:
# 1. API Key: Profile → Extras → API Keys → Create A Key
# 2. Audience ID: Audience → All Contacts → Settings → Audience ID
# 3. Server Prefix: The part after the dash in your API key (e.g., us20, us21)

MAILCHIMP_API_KEY=your_api_key_here
MAILCHIMP_AUDIENCE_ID=your_audience_id_here
MAILCHIMP_API_SERVER=us20

# Site URL for Open Graph social sharing
# On Vercel, set this to your production domain
# Example: https://aivarasolutions.com or https://yoursite.vercel.app
NEXT_PUBLIC_SITE_URL=https://aivarasolutions.com
